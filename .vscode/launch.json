{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend API (Flask)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "program": "${workspaceFolder}/backend/run.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_DEBUG": "False",
        "FLASK_USE_RELOADER": "False",
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug MCP Protocol Server",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "program": "${workspaceFolder}/mcp/server.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_DEBUG": "False",
        "FLASK_USE_RELOADER": "False",
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug All Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "program": "${workspaceFolder}/tests/test_all_features.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug Current Active Python File",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
